# Hashed Vite bundles never change under the same name; everything else,
# including the HTML shell and SPA fallback, must revalidate. Proxied API
# responses keep whatever caching the API chooses (empty value adds nothing).
# Only successful bundle responses are immutable, so a missing asset's 404 is
# never pinned in caches for a year.
map $status$uri $halligalli_cache_control {
  ~^(200|304)/assets/ "public, max-age=31536000, immutable";
  ~^[0-9]+/(api|ws)/ "";
  default "no-cache";
}

# TLS terminates at the ingress in front of this server, so keep the
# client-facing scheme it reports instead of this hop's plain HTTP.
map $http_x_forwarded_proto $halligalli_forwarded_proto {
  "" $scheme;
  default $http_x_forwarded_proto;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 256;
  gzip_types text/css text/plain application/javascript application/json application/manifest+json image/svg+xml;

  # Declared only at server level: a location with its own add_header would
  # silently drop all of these.
  add_header Cache-Control $halligalli_cache_control always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  location = /internal/identity {
    try_files /internal-identity.json =404;
  }

  location /api/ {
    proxy_pass $HALLIGALLI_API_ORIGIN;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $halligalli_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
  }

  location /ws/ {
    proxy_pass $HALLIGALLI_API_ORIGIN;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $halligalli_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
  }

  # A missing hashed bundle is a 404, never the HTML shell served as script.
  location /assets/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
